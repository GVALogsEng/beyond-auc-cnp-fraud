# data is never committed. Leading slash is load-bearing: unanchored `data/` matches a
# directory named data at ANY depth, which silently swallowed the src/data/ package.
# Note `git check-ignore -v src/data` (no trailing slash) prints nothing even when the
# path IS ignored -- git can't tell a nonexistent path is a directory. Check `src/data/`.
/data/

# derived app artifacts (contain competition data samples - do not redistribute)
app/artifacts/

# python
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# logs
logs/
*.log

# OS
.DS_Store

.claude/
CLAUDE.md
